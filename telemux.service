[Unit]
Description=Telegram controller for Claude Code tmux sessions
After=network-online.target

[Service]
# %h is the user's home. `telemux.py --setup` writes this file with absolute paths
# into ~/.config/systemd/user/; this copy is the template for doing it by hand.
ExecStart=/usr/bin/python3 %h/telemux/telemux.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
